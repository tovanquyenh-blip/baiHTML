<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gộp ô trong bảng</title>
</head>
<body>

    <h2>Thời khóa biểu</h2>

    <!-- Bảng thời khóa biểu sử dụng rowspan và colspan -->
    <table border="1">
        <!-- Hàng tiêu đề -->
        <tr>
            <th>Thứ</th>
            <th>Môn học</th>
            <th>Giáo viên</th>
        </tr>

        <!-- Hàng 1: Thứ Hai - Tiết 1 (Toán) -->
        <tr>
            <!-- Gộp 2 hàng cho cột Thứ Hai -->
            <td rowspan="2">Thứ Hai</td>
            <td>Toán</td>
            <td>Thầy Nam</td>
        </tr>

        <!-- Hàng 2: Thứ Hai - Tiết 2 (Văn) -->
        <tr>
            <td>Văn</td>
            <td>Cô Hạnh</td>
        </tr>

        <!-- Hàng 3: Thứ Ba -->
        <tr>
            <td>Thứ Ba</td>
            <!-- Gộp 2 cột Môn học và Giáo viên -->
            <td colspan="2">Nghỉ học</td>
        </tr>
    </table>

</body>
</html>
